with "config/a0b_espidf_timer_clock_timer_config.gpr";

with "espidfada.gpr";

limited with "a0b_time.gpr";
limited with "a0b_timer.gpr";

library project A0B_ESPIDF_Timer_Clock_Timer is

   for Languages use ESPIDFAda.Crate_Languages_Ada_C;
   for Library_Name use "a0b_espidf_timer_clock_timer";
   for Library_Dir use ESPIDFAda.Crate_Library_Dir;
   for Object_Dir use ESPIDFAda.Crate_Object_Dir;

   for Source_Dirs use ("source");

   package Compiler is
      for Switches ("Ada") use
        A0B_ESPIDF_Timer_Clock_Timer_Config.Ada_Compiler_Switches
        & ESPIDFAda.Compiler_Switches_Ada;
   end Compiler;

end A0B_ESPIDF_Timer_Clock_Timer;
